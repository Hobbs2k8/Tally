# Copy to .env.local. Every key is optional: with none set, the app runs on the
# DeterministicProvider and sends nothing to Sentry.

# Gemini (intent extraction, company matching, routing, plain-English summaries)
GEMINI_API_KEY=
# Optional: pin a model. If unset, the app lists models with your key and
# picks the newest Flash model that supports generateContent (see npm run gemini:models).
GEMINI_MODEL=

# Reasoning provider: gemini | deterministic | systemone (default: gemini when a key is set)
REASONING_PROVIDER=

# Sentry (tracing + logs + session replay). DSN is safe to expose; the auth token is build-time only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
