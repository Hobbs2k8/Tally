# Copy to .env.local. Every key is optional: with none set, the app runs on the
# DeterministicProvider and sends nothing to Sentry.

# Gemini (intent extraction, company matching, routing, plain-English summaries)
GEMINI_API_KEY=
# Optional: pin a model. If unset, the app lists models with your key and
# picks the newest Flash model that supports generateContent (see npm run gemini:models).
GEMINI_MODEL=

# Reasoning provider: gemini | deterministic | systemone (default: gemini when a key is set)
# systemone uses TypeSafe when TYPESAFE_API_KEY is set, else a local open-source stand-in (no key needed)
REASONING_PROVIDER=

# Sentry (tracing + logs + session replay). DSN is safe to expose; the auth token is build-time only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# TypeSafe System One (optional; without it REASONING_PROVIDER=systemone runs the local stand-in)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional: require this key (x-api-key header) on POST /api/plan. Set it on public
# deployments and give the same value to the Agentverse agent's secret of the same name.
COMMAND_CENTER_API_KEY=
