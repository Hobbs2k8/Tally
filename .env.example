# Copy to .env and fill in. .env is gitignored; never commit real values.

# Agent identity seeds (any long random string; keep them stable so addresses don't change)
BUYER_SEED=
SUPPLIER_SEED=

# Optional: Claude writes supplier messages and owner replies. Falls back to templates if unset.
ANTHROPIC_API_KEY=

# Optional: TypeSafe Jev model for supplier prediction. Falls back to HeuristicPredictor if unset.
TYPESAFE_API_KEY=
# Optional: Jev model name (SDK default is jev-latest)
TYPESAFE_MODEL=

# Demo company folder under data/
COMPANY_ID=company-001

# Optional: model for message writing (default claude-opus-5-5)
CLAUDE_MODEL=

# Owner cash floor used by the terminal demo (dollars)
CASH_FLOOR=20000

# Optional supplier settings for the demo (random if unset)
SUPPLIER_PERSONALITY=
SUPPLIER_SEASON=
SUPPLIER_RNG_SEED=

# Bureau port
BUREAU_PORT=8000

# Marketplace: owner deadline for delivery (days) and judge control file
NEED_BY_DAYS=7
MARKET_CONTROLS=market_controls.json

# QuickBooks Command Center chat agent (python -m agents.command_center); see command-center/README.md
COMMAND_CENTER_SEED=
# Optional: API base URL, default company, agent port
COMMAND_CENTER_URL=http://localhost:3000
COMMAND_CENTER_COMPANY=company-002
COMMAND_CENTER_PORT=8002
# Optional: send to /api/plan when the deployment requires a key (command-center/.env COMMAND_CENTER_API_KEY)
COMMAND_CENTER_API_KEY=

# Optional: Agentverse "Connect an agent" flow. With an API key from agentverse.ai set here,
# python -m agents.command_center lists itself under your Agentverse account on startup.
AGENTVERSE_KEY=
AGENTVERSE_AGENT_NAME=Command-Center
AGENTVERSE_HANDLE=odumosu
